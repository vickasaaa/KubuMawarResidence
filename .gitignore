# ──────────────────────────────────────
# Root
# ──────────────────────────────────────
.env
*.log
*.tsbuildinfo
*.chunk
/vendor
/node_modules
/public/hot
/public/storage
/storage/*.key
auth.json
dist
dist-ssr

# ──────────────────────────────────────
# Frontend (Vue / Vite)
# ──────────────────────────────────────
frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/*.local
frontend/.env
frontend/.env.*
!frontend/.env.example

# ──────────────────────────────────────
# Backend (Laravel)
# ──────────────────────────────────────
backend/vendor
backend/node_modules
backend/.env
backend/.env.*
!backend/.env.example
backend/storage/*.key
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/cache/data/
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/public/hot
backend/public/storage

# ──────────────────────────────────────
# Editor & OS
# ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
